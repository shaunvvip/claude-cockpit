  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "ws": "^8.18.0",
    "@clack/prompts": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.22.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
